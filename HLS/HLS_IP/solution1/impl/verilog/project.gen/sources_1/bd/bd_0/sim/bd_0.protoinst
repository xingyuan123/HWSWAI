						"TDEST": { "actual": "in_data_TDEST"},
						"TID": { "actual": "in_data_TID"},
						"TKEEP": { "actual": "in_data_TKEEP"},
						"TLAST": { "actual": "in_data_TLAST"},
						"TREADY": { "actual": "in_data_TREADY"},
						"TSTRB": { "actual": "in_data_TSTRB"},
						"TUSER": { "actual": "in_data_TUSER"},
						"TVALID": { "actual": "in_data_TVALID"}
					}
				},
				"/hls_inst/out_data": {
					"interface": "xilinx.com:interface:axis:1.0",
					"ports": {
						"ACLK": { "actual": "ap_clk"},
						"ARESETN": { "actual": "ap_rst_n"},
						"TDATA": { "actual": "out_data_TDATA"},
						"TDEST": { "actual": "out_data_TDEST"},
						"TID": { "actual": "out_data_TID"},
						"TKEEP": { "actual": "out_data_TKEEP"},
						"TLAST": { "actual": "out_data_TLAST"},
						"TREADY": { "actual": "out_data_TREADY"},
						"TSTRB": { "actual": "out_data_TSTRB"},
						"TUSER": { "actual": "out_data_TUSER"},
						"TVALID": { "actual": "out_data_TVALID"}
					}
				}
			}
		}
	}
